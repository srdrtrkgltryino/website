}
const {lang, platform} = Astro.props;
const P = platform === 'shopify' ? 'Shopify' : 'ikas';
const mail = `<a href="mailto:${co.privacyEmail}">${co.privacyEmail}</a>`;

// ikas app (engine model).
const access = {
  ikas: {
    en: `<ul>
      <li><strong>Orders</strong> (read): to award points and settle them on returns and cancellations.</li>
      <li><strong>Customers</strong> (read: name, e-mail, phone, contact permissions): to recognise members when they sign in to the store.</li>
      <li><strong>Campaigns</strong> (read and write): to apply member and tier benefits as ikas campaigns, so prices change in the cart without codes.</li>
    </ul>
    <p>The app does not access payment card data.</p>`,
    tr: `<ul>
      <li><strong>Siparişler</strong> (okuma): puan vermek, iade ve iptallerde puanı düzeltmek için.</li>
      <li><strong>Müşteriler</strong> (okuma: ad, e-posta, telefon, iletişim izinleri): mağazada oturum açan üyeleri tanımak için.</li>
      <li><strong>Kampanyalar</strong> (okuma ve yazma): üye ve kademe avantajlarını ikas kampanyası olarak uygulamak, böylece fiyatın sepette kodsuz değişmesi için.</li>
    </ul>
    <p>Uygulama ödeme kartı verilerine erişmez.</p>`,
  },
}.ikas;

const removal = {
  ikas: {
    en: `<p>When the merchant uninstalls the app, we stop accessing the store and delete its access credentials. Program data held in Ino Loyalty is then deleted or returned as the merchant's Ino Loyalty agreement sets out. Shopper requests for access or deletion go to the merchant, who handles them with the privacy tools in Ino Loyalty.</p>`,
    tr: `<p>Mağaza uygulamayı kaldırdığında mağazaya erişimi durdurur, erişim bilgilerini sileriz. Ino Loyalty'de tutulan program verileri, mağazanın Ino Loyalty sözleşmesinde belirtildiği şekilde silinir ya da iade edilir. Müşterilerin erişim ve silme talepleri mağazaya iletilir; mağaza bunları Ino Loyalty'deki gizlilik araçlarıyla karşılar.</p>`,
  },
}.ikas;

