const table = (head: [string, string], rows: [string, string][]) =>
  `<div class="table"><table><thead><tr><th>${head[0]}</th><th>${head[1]}</th></tr></thead><tbody>${rows.map(([a, b]) => `<tr><td>${a}</td><td>${b}</td></tr>`).join('')}</tbody></table></div>`;
const link = (key: 'termsShopify' | 'dpaShopify' | 'incidentResponse' | 'support' | 'privacy', text: string) => `<a href="${href(lang, key)}">${text}</a>`;

