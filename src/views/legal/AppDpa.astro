// Data processing agreement (DPA) for the Ino Loyalty app installed from the Shopify App Store (standalone app).
// The merchant is the controller, Tryino the processor (KVKK and GDPR).
// Sources: Ino-Loyalty-NET docs/shopify-store/protected-customer-data-standalone.md (§1, §3, §4–§6),
// docs/shopify-store/incident-response-policy.md (§6), docs/kvkk/veri-envanteri.json (ino-shop-engine, ino-connect rows),
// docs/SHOPIFY_CONNECTED.md (move to the merchant's own engine). Checked 2026-11-06.
// Draft for the owner's lawyer. Search for "TODO(owner)" before publishing.
import LegalDoc, {type Section} from '../../components/LegalDoc.astro';
import {company as co} from '../../data/company';
import {href, type Lang} from '../../i18n';

interface Props {
  lang: Lang;
}
const {lang} = Astro.props;
const updated = '2026-11-06';
const privacy = `<a href="mailto:${co.privacyEmail}">${co.privacyEmail}</a>`;
const terms = (text: string) => `<a href="${href(lang, 'termsShopify')}">${text}</a>`;
const policy = (text: string) => `<a href="${href(lang, 'privacyShopify')}">${text}</a>`;
const incident = (text: string) => `<a href="${href(lang, 'incidentResponse')}">${text}</a>`;
const table = (head: string[], rows: string[][]) =>
  `<div class="table"><table><thead><tr>${head.map((h) => `<th>${h}</th>`).join('')}</tr></thead><tbody>${rows
    .map((r) => `<tr>${r.map((d) => `<td>${d}</td>`).join('')}</tr>`)
    .join('')}</tbody></table></div>`;

// Categories of personal data, with retention (protected-customer-data-standalone.md §3).
const dataEn = [
  ['Shopify customer ID; membership: join date, status, tier, referral code', 'While the app is installed, until the customer’s data is erased'],
  ['Loyalty transactions: points ledger, basket point reservations, expiry, tier history', 'While the membership exists'],
  ['Order summaries: order ID and number, amount, currency, date, channel, products, discount titles, points', 'While the app is installed. On customers/redact, unlinked from the person and cleared.'],
  ['Activity: game plays and scores, product likes (“This or that”), daily check-ins, garden watering, badges, referrals between members', 'Game plays, likes and check-ins: deleted after the period the merchant sets (30 to 1,095 days, 365 by default). Others: while the membership exists.'],
  ['Incoming order notifications, reduced to the fields above', 'Content emptied once processed; rows deleted after 30 days (failed rows after 14)'],
  ['Technical event log: Shopify customer and resource IDs', '90 days'],
  ['Data access reports for customers/data_request', 'Emptied after 30 days, deleted after 60 days'],
  ['Merchant staff: Shopify staff user ID on point adjustments (with the reason typed) and on game-of-chance declarations', 'With the related record, or while the store has the app'],
];
const dataTr = [
  ['Shopify müşteri kimliği; üyelik: katılma tarihi, durum, kademe, davet kodu', 'Uygulama kurulu kaldığı sürece, müşterinin verisi silinene kadar'],
  ['Sadakat işlemleri: puan defteri, sepette puan ayırmaları, sona erme, kademe geçmişi', 'Üyelik sürdüğü sürece'],
  ['Sipariş özetleri: sipariş kimliği ve numarası, tutar, para birimi, tarih, kanal, ürünler, indirim başlıkları, puan', 'Uygulama kurulu kaldığı sürece. customers/redact talebinde kişiden ayrılır ve temizlenir.'],
  ['Hareketler: oyunlar ve skorlar, ürün beğenileri (“Bu mu Şu mu”), günlük girişler, bahçe sulama, rozetler, üyeler arası davetler', 'Oyunlar, beğeniler ve günlük girişler: mağazanın belirlediği sürenin sonunda silinir (30 ile 1.095 gün arası, varsayılan 365). Diğerleri: üyelik sürdüğü sürece.'],
  ['Gelen sipariş bildirimleri, yukarıdaki alanlara indirgenmiş', 'İşlenince içeriği boşaltılır; satırlar 30 gün sonra silinir (hatalı satırlar 14 gün sonra)'],
  ['Teknik olay kaydı: Shopify müşteri ve kaynak kimlikleri', '90 gün'],
  ['customers/data_request için veri erişim raporları', '30 gün sonra boşaltılır, 60 gün sonra silinir'],
  ['Mağaza personeli: puan düzeltmelerinde (yazılan gerekçeyle) ve şans oyunu beyanlarında Shopify personel kullanıcı kimliği', 'İlgili kayıtla birlikte ya da mağazada uygulama kurulu kaldığı sürece'],
];

// Security measures (protected-customer-data-standalone.md §4 item 9, §5).
// TODO(owner): MFA on every admin account (Microsoft Entra/Azure, Shopify Partner, GitHub, Cloudflare) is still marked
// [confirm] in the source doc, so it is not claimed below. Add it once confirmed.
const securityEn = `<ul>
  <li><strong>Encryption in transit:</strong> HTTPS only, with HSTS, on all app endpoints. The database is reached over a private network with TLS.</li>
  <li><strong>Encryption at rest:</strong> database storage and backups are encrypted by Azure. Shopify access tokens are additionally sealed with AES-GCM, with the key held in Azure Key Vault.</li>
  <li><strong>Network:</strong> the PostgreSQL database is on a private network and is not reachable from the internet. Administrative endpoints are switched off in production.</li>
  <li><strong>Secrets:</strong> kept only in Azure Key Vault and read by managed identities; each service reads only its own secrets.</li>
  <li><strong>Separation of stores:</strong> PostgreSQL row-level security keeps each store’s data apart. The service refuses to start under a database role that could bypass it, and automated tests check cross-store access.</li>
  <li><strong>Data minimisation:</strong> order notifications are reduced before storage, so names, e-mail, phone and addresses are never written. Customer names are read live from Shopify for the merchant’s admin screens and never stored. Logs contain no shopper data.</li>
  <li><strong>Merchant-side access:</strong> the app’s admin pages check Shopify session tokens and are limited to the store owner and staff with permission to manage discounts. Staff point adjustments have daily limits and are logged with the staff user ID.</li>
  <li><strong>Webhooks:</strong> Shopify webhooks are verified by signature, and a request that names a different store is rejected.</li>
  <li><strong>Tryino access:</strong> production access is limited by Azure role-based access control to the people who operate the app.</li>
  <li><strong>Logging:</strong> access to secrets in Azure Key Vault (audit events) and connections to the database are logged to Azure Log Analytics and kept for 90 days. Application logs contain no shopper data.</li>
  <li><strong>Test and production:</strong> production runs in its own environment, with its own network, database, key vault and Shopify app. Production data is not copied to test.</li>
  <li><strong>Resilience:</strong> point-in-time backups for 14 days in the same region, with restore tests at least once a year.</li>
  <li><strong>Incidents:</strong> a written ${incident('security incident response policy')}.</li>
</ul>`;
const securityTr = `<ul>
  <li><strong>Aktarımda şifreleme:</strong> uygulamanın tüm uçlarında yalnız HTTPS ve HSTS. Veritabanına özel ağ üzerinden TLS ile bağlanılır.</li>
  <li><strong>Depolamada şifreleme:</strong> veritabanı depolaması ve yedekler Azure tarafından şifrelenir. Shopify erişim anahtarları ayrıca AES-GCM ile şifrelenir; anahtar Azure Key Vault'ta tutulur.</li>
  <li><strong>Ağ:</strong> PostgreSQL veritabanı özel bir ağdadır, internetten erişilemez. Yönetim uçları üretimde kapalıdır.</li>
  <li><strong>Sırlar:</strong> yalnız Azure Key Vault'ta tutulur ve yönetilen kimliklerle okunur; her servis yalnız kendi sırlarını okur.</li>
  <li><strong>Mağazaların ayrımı:</strong> PostgreSQL satır düzeyinde güvenlik her mağazanın verisini ayrı tutar. Servis, bunu atlayabilecek bir veritabanı rolüyle açılmayı reddeder; otomatik testler mağazalar arası erişimi denetler.</li>
  <li><strong>Veri azaltma:</strong> sipariş bildirimleri saklanmadan önce indirgenir; ad, e-posta, telefon ve adres hiç yazılmaz. Müşteri adları mağazanın yönetim ekranları için Shopify'dan o an okunur, saklanmaz. Kayıtlarda müşteri verisi yoktur.</li>
  <li><strong>Mağaza tarafında erişim:</strong> uygulamanın yönetim sayfaları Shopify oturum anahtarını doğrular ve mağaza sahibi ile indirim yönetme izni olan personelle sınırlıdır. Personelin puan düzeltmelerinde günlük sınır vardır ve personel kullanıcı kimliğiyle kaydedilir.</li>
  <li><strong>Webhook'lar:</strong> Shopify webhook'ları imzayla doğrulanır; başka bir mağazayı adlandıran istek reddedilir.</li>
  <li><strong>Tryino erişimi:</strong> üretim erişimi Azure rol tabanlı erişim denetimiyle uygulamayı işleten kişilerle sınırlıdır.</li>
  <li><strong>Kayıt tutma:</strong> Azure Key Vault'taki sırlara erişim (denetim olayları) ve veritabanı bağlantıları Azure Log Analytics'e kaydedilir ve 90 gün saklanır. Uygulama kayıtlarında müşteri verisi yoktur.</li>
  <li><strong>Test ve üretim:</strong> üretim kendi ağı, veritabanı, anahtar kasası ve Shopify uygulamasıyla ayrı bir ortamda çalışır. Üretim verisi teste kopyalanmaz.</li>
  <li><strong>Süreklilik:</strong> aynı bölgede 14 günlük, zamana dönük geri yüklenebilir yedekler; geri yükleme en az yılda bir denenir.</li>
  <li><strong>Olaylar:</strong> yazılı bir ${incident('güvenlik olayı müdahale politikası')}.</li>
</ul>`;

const en: {title: string; description: string; eyebrow: string; h1: string; intro: string; sections: Section[]} = {
  title: 'Ino Loyalty for Shopify data processing agreement · Tryino',
  description: 'The data processing agreement between merchants (controllers) and Tryino (processor) for the Ino Loyalty app for Shopify, under KVKK and GDPR.',
  eyebrow: 'Ino Loyalty for Shopify',
  h1: 'Data processing agreement',
  intro: `This data processing agreement (DPA) forms part of the Ino Loyalty for Shopify terms of service between ${co.legalName} and the merchant. It applies whenever Tryino processes personal data for the merchant through the app, and is accepted with the terms when the app is installed.`,
  sections: [
    {
      id: 'scope',
      title: 'Scope and definitions',
      html: `<ul>
        <li><strong>Data protection law</strong> means the laws that apply to the processing, including Türkiye’s Law No. 6698 on the Protection of Personal Data (KVKK), the EU General Data Protection Regulation 2016/679 (GDPR) and, where they apply, the UK GDPR and the Swiss Federal Act on Data Protection.</li>
        <li><strong>Personal data, processing, controller, processor, data subject</strong> and <strong>personal data breach</strong> have the meaning given in data protection law. Under KVKK, the controller is the <em>veri sorumlusu</em> and the processor the <em>veri işleyen</em>.</li>
        <li><strong>Merchant personal data</strong> means personal data that Tryino processes on the merchant’s behalf through the app.</li>
        <li>This DPA does not cover Tryino’s own business data about merchants, such as contact details and support correspondence, for which Tryino is the controller under its general <a href="${href(lang, 'privacy')}">privacy policy</a>. It does not cover the Ino Loyalty Engine, which has its own agreement.</li>
      </ul>`,
    },
    {
      id: 'roles',
      title: 'Roles',
      html: `<p>The merchant is the <strong>controller</strong> of merchant personal data and decides why and how it is processed. Tryino is the <strong>processor</strong> and processes it only on the merchant’s behalf. Each party complies with the data protection law that applies to it.</p>`,
    },
    {
      id: 'details',
      title: 'Details of the processing',
      html: `<h3>Subject matter and duration</h3>
      <p>Providing the Ino Loyalty app to the merchant under the ${terms('terms of service')}, for as long as the app is installed and afterwards until the data is deleted under the “Deletion and return” section.</p>
      <h3>Nature and purpose</h3>
      <p>Receiving, storing, calculating, displaying, reporting and deleting loyalty data in order to run the merchant’s loyalty program: earning and spending points, tiers, campaigns, referrals, missions and games; showing the merchant its members and reports; writing each member’s points balance and tier to the Shopify customer record as app fields and tags; answering Shopify privacy requests; and keeping the service secure and working.</p>
      <h3>Data subjects</h3>
      <ul>
        <li>The merchant’s customers who join the loyalty program.</li>
        <li>The merchant’s customers whose orders the app receives before or without joining. For them, only order identifiers and the Shopify customer ID are kept, briefly; orders of non-members are kept only as a count, without products.</li>
        <li>The merchant’s staff who use the app, identified by their Shopify staff user ID.</li>
      </ul>
      <h3>Categories of personal data and retention</h3>
      ${table(['Data', 'Retention'], dataEn)}
      <p><strong>Read but not stored:</strong> the customer’s name is read live from Shopify to show it to the merchant’s staff in the app’s admin pages, and is never written to our database, logs or reports. Search text that staff type in the member search is passed to Shopify’s customer search and is not stored.</p>
      <p><strong>Not processed:</strong> e-mail addresses, phone numbers, postal addresses and payment data are not stored. No special categories of personal data are processed.</p>`,
      // TODO(owner): Shopify Level 2 "Email" is still undecided (protected-customer-data-standalone.md §1). If the member
      // search is limited to names and IDs, remove the search-text sentence above; if Email access is requested, keep it.
    },
    {
      id: 'instructions',
      title: 'Processing on instructions',
      html: `<p>Tryino processes merchant personal data only on the merchant’s documented instructions. These terms, this DPA and the settings the merchant chooses in the app are those instructions. Tryino will tell the merchant if it believes an instruction breaks data protection law, and may then decline to follow it. If the law requires Tryino to process data otherwise, Tryino will tell the merchant first, unless the law forbids it. Tryino does not sell merchant personal data, does not use it for its own purposes or for advertising, and does not combine it with other stores’ data.</p>`,
    },
    {
      id: 'confidentiality',
      title: 'Confidentiality of personnel',
      html: `<p>Tryino gives access to merchant personal data only to personnel who need it to operate, support or secure the app, and makes sure they are bound by confidentiality obligations that continue after their work ends.</p>`,
    },
    {
      id: 'security',
      title: 'Security measures',
      html: `<p>Tryino takes appropriate technical and organisational measures to protect merchant personal data, taking into account the state of the art, the cost, and the nature and risks of the processing. The measures in place today are:</p>${securityEn}<p>Tryino may change the measures, but not in a way that lowers the overall level of protection.</p>`,
    },
    {
      id: 'subprocessors',
      title: 'Sub-processors',
      html: `<p>The merchant gives Tryino general authorisation to use sub-processors. The current sub-processors are:</p>
      ${table(['Sub-processor', 'Purpose', 'Location'], [
        ['Microsoft (Azure): Container Apps, Database for PostgreSQL, Key Vault, Container Registry, Log Analytics / Monitor', 'Hosting, database, secrets and logs: all stored merchant personal data', 'France Central (Paris, EU)'],
        ['Microsoft 365 (Exchange Online)', `Our support and privacy mailboxes; only what merchants or shoppers write to us`, 'Microsoft 365 data location of Tryino’s tenant'],
      ])}
      <ul>
        <li>Shopify is the merchant’s own platform and is not Tryino’s sub-processor. Cloudflare provides DNS only and receives no personal data.</li>
        <li>Tryino will tell the merchant about a new or replaced sub-processor at least 30 days in advance, in the app or by e-mail, and update this list. The merchant may object on reasonable data protection grounds. If we cannot resolve the objection, the merchant may end the terms by uninstalling the app.</li>
        <li>Tryino imposes data protection obligations on each sub-processor that are no less protective than this DPA and remains responsible to the merchant for them.</li>
      </ul>`,
      // TODO(owner): Confirm the Microsoft 365 data location of the tryino.com tenant and replace the location cell above.
      // TODO(owner): If the Cloudflare proxy is switched on before launch (URETIM_ERISIM.md §7), Cloudflare becomes a
      // sub-processor (traffic, IP addresses) and must be added here and in the app privacy policy.
    },
    {
      id: 'transfers',
      title: 'International transfers',
      html: `<p>Merchant personal data is stored by Microsoft Azure in France Central (Paris, EU). ${co.legalName} is based in Türkiye, and its personnel may access the systems remotely from Türkiye to operate and support the app.</p>
      <ul>
        <li>Where the GDPR applies to that access, the EU Standard Contractual Clauses (Commission Implementing Decision (EU) 2021/914, Module Two: controller to processor) are incorporated into this DPA by reference, with the merchant as data exporter and Tryino as data importer. The details of the processing are those in this DPA.</li>
        <li>Where KVKK applies to a transfer abroad, Tryino will sign the standard contract published by the Personal Data Protection Board on the merchant’s request and help the merchant make any notification the Board requires.</li>
        <li>Tryino will not transfer merchant personal data to any other country without a safeguard that data protection law accepts.</li>
      </ul>`,
      // TODO(owner): Lawyer to confirm the transfer mechanism: (1) SCC Module Two by reference, with its options (Clause 7
