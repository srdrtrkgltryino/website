    },
    {
      id: 'liability',
      title: 'Liability',
      html: `<p>Each party’s liability under this DPA is subject to the limitations in the ${terms('terms of service')}, except where data protection law does not allow liability to be limited.</p>`,
    },
    {
      id: 'term',
      title: 'Term and precedence',
      html: `<ul>
        <li>This DPA applies for as long as Tryino processes merchant personal data.</li>
        <li>If this DPA conflicts with the terms of service, this DPA prevails. If the Standard Contractual Clauses apply and conflict with this DPA, the Clauses prevail.</li>
        <li>Apart from the Standard Contractual Clauses, this DPA is governed by the same law and courts as the terms of service.</li>
        <li>We may update this DPA as the terms of service describe; the date at the top shows the latest version. See also the ${policy('app privacy policy')}.</li>
      </ul>`,
    },
    {
      id: 'contact',
      title: 'Contact',
      html: `<p>Privacy and data protection: ${privacy} · ${co.legalName}, ${co.address}</p>`,
    },
