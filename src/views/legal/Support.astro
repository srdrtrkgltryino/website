---
// Support: how to reach us, getting started with the Shopify and ikas apps, and common questions.
// This is the support URL in the app store listings.
import LegalDoc, {type Section} from '../../components/LegalDoc.astro';
import {company as co} from '../../data/company';
import {href, type Lang} from '../../i18n';

interface Props {
  lang: Lang;
}
const {lang} = Astro.props;
const support = `<a href="mailto:${co.supportEmail}">${co.supportEmail}</a>`;

const en: {title: string; description: string; eyebrow: string; h1: string; intro: string; sections: Section[]} = {
  title: 'Support · Tryino',
  description: 'Get help with Ino Loyalty, the Shopify and ikas apps, the API and our Dynamics 365 services: contact support, setup guides and answers to common questions.',
  eyebrow: 'Support',
  h1: 'How can we help?',
  intro: 'Write to us and a person from the team that builds Ino Loyalty will answer. Most questions are answered within one business day.',
  sections: [
    {
      id: 'contact',
      title: 'Contact support',
      html: `<div class="callout"><p><strong>E-mail:</strong> ${support}<br/>Monday to Friday, 09:00–18:00 (Türkiye time, UTC+3).</p></div>
      <p>To help us answer quickly, include your store or company name, which app or channel you use (Shopify, ikas, POS, API), what you expected and what happened, and a screenshot if you can. Please do not send passwords or full card numbers.</p>`,
    },
    {
      id: 'ikas',
      title: 'Getting started with the ikas app',
      html: `<ol>
        <li>Install <strong>Ino Loyalty</strong> from the ikas App Store and approve the permissions it asks for.</li>
        <li>Your Tryino team links the store to your Ino Loyalty program.</li>
        <li>The Rewards panel and the My Rewards page appear on your storefront with no theme changes. Member benefits are applied as ikas campaigns, so prices change in the cart without codes.</li>
      </ol>`,
    },
    {
      id: 'faq',
      title: 'Common questions',
      html: `<h3>Do I need an Ino Loyalty account?</h3>
      <p><strong>Shopify:</strong> no. The Shopify app works on its own: you install it from the Shopify App Store and Shopify bills your plan. <strong>ikas:</strong> yes. The ikas app is free to install and connects your store to Ino Loyalty, which you use under an agreement with Tryino. <a href="${href(lang, 'demo')}">Book a demo</a> to get started.</p>
      <h3>Which languages are supported?</h3>
      <p><strong>Shopify:</strong> see the languages under <a href="#shopify">Ino Loyalty for Shopify</a>. <strong>ikas:</strong> the app and the shopper experience are available in English and Turkish. You translate your own program content (reward names, descriptions) in Ino Loyalty.</p>
      <h3>How do I uninstall?</h3>
      <p><strong>Shopify:</strong> remove the app from your Shopify admin. Shopify asks us to delete your store’s data 48 hours later, and we do. <strong>ikas:</strong> remove the app from your ikas admin. Your program stays in Ino Loyalty; tell us if you want its data deleted or returned. See the app privacy policies for <a href="${href(lang, 'privacyShopify')}">Shopify</a> and <a href="${href(lang, 'privacyIkas')}">ikas</a>.</p>
      <h3>A shopper wants their data deleted. What do I do?</h3>
      <p><strong>Shopify:</strong> nothing. Shopify passes the request to the app and the deletion happens automatically. <strong>ikas:</strong> use the privacy tools in Ino Loyalty or write to us; we help you answer within the legal deadline.</p>
      <h3>Where is the API documentation?</h3>
      <p>In <a href="${href(lang, 'developers')}">For developers</a>, with the full <a href="${href(lang, 'apiReference')}">API reference</a>. API credentials come with your Ino Loyalty agreement.</p>`,
    },
    {
      id: 'services',
      title: 'CRM implementation customers',
      html: `<p>If we implemented Microsoft Dynamics 365 for you, write to ${support} or to your project contact. Include the environment name and, for errors, the time it happened.</p>`,
    },
    {
      id: 'privacy',
      title: 'Privacy requests',
      html: `<p>For questions about your personal data, write to <a href="mailto:${co.privacyEmail}">${co.privacyEmail}</a>. See our <a href="${href(lang, 'privacy')}">privacy policy</a>.</p>`,
    },
  ],
};

const tr: typeof en = {
  title: 'Destek · Tryino',
  description: 'Ino Loyalty, Shopify ve ikas uygulamaları, API ve Dynamics 365 hizmetlerimiz için yardım: destek ekibine ulaşın, kurulum adımları ve sık sorulan sorular.',
  eyebrow: 'Destek',
  h1: 'Nasıl yardımcı olabiliriz?',
  intro: 'Bize yazın; Ino Loyalty\'yi geliştiren ekipten biri yanıt versin. Soruların çoğunu bir iş günü içinde yanıtlıyoruz.',
  sections: [
    {
      id: 'contact',
      title: 'Destek ekibine ulaşın',
      html: `<div class="callout"><p><strong>E-posta:</strong> ${support}<br/>Pazartesi–Cuma, 09:00–18:00 (Türkiye saati).</p></div>
      <p>Hızlı yanıt verebilmemiz için mağaza ya da şirket adınızı, hangi uygulama ya da kanalı kullandığınızı (Shopify, ikas, kasa, API), ne beklediğinizi ve ne olduğunu, mümkünse bir ekran görüntüsüyle yazın. Lütfen parola ya da kart numarası göndermeyin.</p>`,
    },
    {
      id: 'ikas',
      title: 'ikas uygulamasıyla başlangıç',
      html: `<ol>
        <li><strong>Ino Loyalty</strong>'yi ikas App Store'dan kurun ve istediği izinleri onaylayın.</li>
        <li>Tryino ekibiniz mağazayı Ino Loyalty programınıza bağlar.</li>
        <li>Rewards paneli ve My Rewards sayfası tema değişikliği gerekmeden mağazanızda görünür. Üye avantajları ikas kampanyası olarak uygulanır; fiyat sepette kodsuz değişir.</li>
      </ol>`,
    },
    {
      id: 'faq',
      title: 'Sık sorulanlar',
      html: `<h3>Ino Loyalty hesabı gerekir mi?</h3>
      <p><strong>Shopify:</strong> hayır. Shopify uygulaması kendi başına çalışır: Shopify App Store'dan kurarsınız, planınızı Shopify faturalar. <strong>ikas:</strong> evet. ikas uygulamasının kurulumu ücretsizdir ve mağazanızı Tryino ile yaptığınız sözleşme kapsamında kullandığınız Ino Loyalty'ye bağlar. Başlamak için <a href="${href(lang, 'demo')}">demo planlayın</a>.</p>
      <h3>Hangi diller destekleniyor?</h3>
      <p><strong>Shopify:</strong> dilleri <a href="#shopify">Shopify için Ino Loyalty</a> bölümünde bulabilirsiniz. <strong>ikas:</strong> uygulama ve müşteri deneyimi İngilizce ve Türkçe. Program içeriğinizi (ödül adları, açıklamalar) Ino Loyalty'de kendiniz çevirirsiniz.</p>
      <h3>Nasıl kaldırırım?</h3>
      <p><strong>Shopify:</strong> uygulamayı Shopify yönetim panelinizden kaldırın. Shopify 48 saat sonra mağazanızın verisini silmemizi ister, biz de sileriz. <strong>ikas:</strong> uygulamayı ikas yönetim panelinizden kaldırın. Programınız Ino Loyalty'de kalır; verilerinin silinmesini ya da iadesini isterseniz bize yazın. Ayrıntılar <a href="${href(lang, 'privacyShopify')}">Shopify</a> ve <a href="${href(lang, 'privacyIkas')}">ikas</a> gizlilik politikalarında.</p>
      <h3>Bir müşteri verilerinin silinmesini istiyor. Ne yapmalıyım?</h3>
      <p><strong>Shopify:</strong> bir şey yapmanız gerekmez. Shopify talebi uygulamaya iletir, silme kendiliğinden yapılır. <strong>ikas:</strong> Ino Loyalty'deki gizlilik araçlarını kullanın ya da bize yazın; yasal süre içinde yanıt vermenize yardım ederiz.</p>
      <h3>API belgeleri nerede?</h3>
      <p><a href="${href(lang, 'developers')}">Geliştiriciler için</a> sayfasında, tam <a href="${href(lang, 'apiReference')}">API referansıyla</a> birlikte. API kimlik bilgileri Ino Loyalty sözleşmenizle verilir.</p>`,
    },
    {
      id: 'services',
      title: 'CRM implementasyonu müşterileri',
      html: `<p>Microsoft Dynamics 365 implementasyonunuzu biz yaptıysak ${support} adresine ya da proje sorumlunuza yazın. Ortam adını ve hatalar için ne zaman olduğunu belirtin.</p>`,
    },
    {
      id: 'privacy',
      title: 'Kişisel veri talepleri',
      html: `<p>Kişisel verilerinizle ilgili sorular için <a href="mailto:${co.privacyEmail}">${co.privacyEmail}</a> adresine yazın. <a href="${href(lang, 'privacy')}">Gizlilik politikamıza</a> bakın.</p>`,
    },
  ],
};
// The Ino Loyalty app listed on the Shopify App Store works on its own, without a connection code or an Ino Loyalty
// agreement, and is billed through Shopify. Merchants who also have an Ino Loyalty Engine are moved to it by Tryino
// (docs/SHOPIFY_CONNECTED.md); there is nothing for them to enter. It is inserted before the ikas section.
const appStore: Record<Lang, Section> = {
  en: {
    id: 'shopify',
    title: 'Ino Loyalty for Shopify',
    html: `<p>The Ino Loyalty app on the Shopify App Store runs your loyalty program inside Shopify. You install it from the Shopify App Store and Shopify bills your plan. You do not need an Ino Loyalty account, a connection code or a separate agreement.</p>
    <h3>Getting started</h3>
    <ol>
      <li>Install <strong>Ino Loyalty</strong> from the Shopify App Store. The app opens in your Shopify admin.</li>
      <li>Choose the language for the app’s admin pages: English, Turkish, French, German, Dutch or Italian. You can change it later in Settings.</li>
      <li>Turn on the recommended set or build your program: points, tiers, campaigns, missions and games. Texts your customers see are written by you, in your store’s language.</li>
      <li>Switch on the Ino Loyalty app embed in the theme editor. The setup page has a button that opens the right place.</li>
      <li>Place a test order. Points appear in the Rewards panel and on the member’s page in the app within a minute.</li>
    </ol>
    <h3>Who can open the app?</h3>
    <p>The store owner, and staff who have permission to manage discounts in Shopify. If a staff member sees a permission message, ask the store owner to give that permission.</p>
    <h3>A shopper wants their data or wants it deleted. What do I do?</h3>
    <p>Shopify passes these requests to the app automatically. For an access request, the report appears in the app for you to download. Deletion happens automatically. See the <a href="${href(lang, 'privacyShopify')}#requests">app privacy policy</a>.</p>
    <h3>How do I uninstall?</h3>
    <p>Remove the app from your Shopify admin. The Rewards panel leaves your storefront at once. Shopify asks us to delete your store’s data 48 hours later, and we do.</p>
    <h3>I also have an Ino Loyalty Engine agreement. What do I do?</h3>
    <p>Nothing in the app. Tryino moves your store to your own engine for you; there is no code to enter. Your customers keep the same Rewards panel, balance and tier. Afterwards the app shows your program from your engine, and you change it there.</p>
    <h3>Contact</h3>
    <p>Write to ${support} with your <em>myshopify.com</em> store address.</p>
    <p>Legal: <a href="${href(lang, 'termsShopify')}">terms of service</a> · <a href="${href(lang, 'dpaShopify')}">data processing agreement</a> · <a href="${href(lang, 'privacyShopify')}">app privacy policy</a> · <a href="${href(lang, 'incidentResponse')}">security incident response policy</a></p>`,
  },
  tr: {
    id: 'shopify',
    title: 'Shopify için Ino Loyalty',
    html: `<p>Shopify App Store'daki Ino Loyalty uygulaması sadakat programınızı Shopify'ın içinde yürütür. Uygulamayı Shopify App Store'dan kurarsınız, planınızı Shopify faturalar. Ino Loyalty hesabına, bağlantı koduna ya da ayrı bir sözleşmeye gerek yoktur.</p>
    <h3>Başlangıç</h3>
    <ol>
      <li><strong>Ino Loyalty</strong>'yi Shopify App Store'dan kurun. Uygulama Shopify yönetim panelinizde açılır.</li>
      <li>Uygulamanın yönetim sayfaları için dili seçin: İngilizce, Türkçe, Fransızca, Almanca, Felemenkçe ya da İtalyanca. Sonra Ayarlar'dan değiştirebilirsiniz.</li>
      <li>Önerilen kurulumu açın ya da programınızı kendiniz kurun: puan, kademe, kampanya, görev ve oyunlar. Müşterilerinizin gördüğü metinleri mağazanızın dilinde siz yazarsınız.</li>
      <li>Tema düzenleyicide Ino Loyalty uygulama yerleştirmesini açın. Kurulum sayfasındaki düğme doğru yeri açar.</li>
      <li>Bir deneme siparişi verin. Puan bir dakika içinde Rewards panelinde ve uygulamadaki üye sayfasında görünür.</li>
    </ol>
    <h3>Uygulamayı kimler açabilir?</h3>
    <p>Mağaza sahibi ve Shopify'da indirim yönetme izni olan personel. Bir personel izin uyarısı görürse mağaza sahibinden bu izni istemelidir.</p>
    <h3>Bir müşteri verisini ya da silinmesini istiyor. Ne yapmalıyım?</h3>
    <p>Shopify bu talepleri uygulamaya otomatik iletir. Erişim talebinde rapor uygulamada indirilmeye hazır olur. Silme kendiliğinden yapılır. <a href="${href(lang, 'privacyShopify')}#requests">Uygulama gizlilik politikasına</a> bakın.</p>
    <h3>Uygulamayı nasıl kaldırırım?</h3>
    <p>Uygulamayı Shopify yönetim panelinizden kaldırın. Rewards paneli vitrinden hemen çıkar. Shopify 48 saat sonra mağazanızın verisini silmemizi ister, biz de sileriz.</p>
    <h3>Ino Loyalty Engine sözleşmem de var. Ne yapmalıyım?</h3>
    <p>Uygulamada bir şey yapmanız gerekmez. Tryino mağazanızı sizin için kendi motorunuza taşır; girilecek bir kod yoktur. Müşterileriniz aynı Rewards panelini, bakiyeyi ve kademeyi görmeye devam eder. Sonrasında uygulama programınızı motorunuzdan gösterir; değişiklikleri orada yaparsınız.</p>
    <h3>İletişim</h3>
    <p>${support} adresine <em>myshopify.com</em> mağaza adresinizle yazın.</p>
    <p>Yasal: <a href="${href(lang, 'termsShopify')}">hizmet şartları</a> · <a href="${href(lang, 'dpaShopify')}">veri işleme sözleşmesi</a> · <a href="${href(lang, 'privacyShopify')}">uygulama gizlilik politikası</a> · <a href="${href(lang, 'incidentResponse')}">güvenlik olayı müdahale politikası</a></p>`,
  },
};
for (const [doc, l] of [[en, 'en'], [tr, 'tr']] as const) {
  const at = doc.sections.findIndex((s) => s.id === 'ikas');
  doc.sections.splice(at, 0, appStore[l]);
}
const c = lang === 'tr' ? tr : en;
const related = [
  {label: lang === 'tr' ? 'Geliştiriciler için' : 'For developers', href: href(lang, 'developers')},
  {label: lang === 'tr' ? 'Shopify uygulaması gizliliği' : 'Shopify app privacy', href: href(lang, 'privacyShopify')},
  {label: lang === 'tr' ? 'ikas uygulaması gizliliği' : 'ikas app privacy', href: href(lang, 'privacyIkas')},
  {label: lang === 'tr' ? 'Shopify uygulaması şartları' : 'Shopify app terms', href: href(lang, 'termsShopify')},
  {label: lang === 'tr' ? 'Veri işleme sözleşmesi' : 'Data processing agreement', href: href(lang, 'dpaShopify')},
  {label: lang === 'tr' ? 'Güvenlik olayı politikası' : 'Incident response policy', href: href(lang, 'incidentResponse')},
];
---

<LegalDoc lang={lang} {...c} related={related} />
