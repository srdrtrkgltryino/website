<script>
  // Gamification teaser: once the visitor has a profile, show their real level, points, badges and coupon.
  import * as V from '../lib/visitor';
  import {avatarSvg, fmt, num} from '../lib/visitor-ui';
  import {visitorCopy} from '../i18n/visitor';

  const box = document.querySelector<HTMLElement>('[data-play-visual]');
  const lang = document.documentElement.lang === 'tr' ? 'tr' : 'en';
  const c = visitorCopy[lang];
  const q = (s: string) => box!.querySelector<HTMLElement>(s)!;
  const preview = box?.innerHTML;
  function render() {
    document.querySelectorAll<HTMLElement>('[data-when]').forEach((el) => (el.hidden = (el.dataset.when === 'started') !== V.isStarted()));
    if (!box) return;
    const s = V.get();
    if (!s) {
      box.innerHTML = preview!;
      q('[data-pv-avatar]').innerHTML = avatarSvg('tryino');
      return;
    }
    const lvl = V.levelFor(s.xp);
    q('[data-pv-avatar]').innerHTML = avatarSvg(s.id);
    q('[data-pv-level]').textContent = c.levels[lvl.id];
    q('[data-pv-xp]').style.width = `${lvl.progress * 100}%`;
    q('[data-pv-next]').textContent = lvl.next ? fmt(c.toNext, {n: lvl.toNext, level: c.levels[lvl.next]}) : c.maxLevel;
    q('[data-pv-points]').textContent = num(s.points, lang);
    q('[data-pv-badges]').innerHTML = V.BADGES.slice(0, 4)
      .map((b) => `<span class="badge${s.badges.some((x) => x.id === b) ? ' b0' : ' off'}">${c.badges[b][0]}</span>`)
      .join('');
    q('[data-pv-code]').textContent = s.coupon?.code ?? 'INOPOC-····-····';
    q('[data-pv-coupon-state]').textContent = s.coupon ? box.dataset.unlocked! : box.dataset.locked!;
  }
  render();
  document.addEventListener('visitor:change', render);
</script>


