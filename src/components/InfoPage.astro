---
// A content page assembled from blocks: hero, card grids, numbered steps, a split section with a list, FAQ and a
// closing call to action. Used by About, CRM implementation, BrowserPing and the hidden pricing page.
import Base from '../layouts/Base.astro';
import type {Lang} from '../i18n';

type Cta = {label: string; href: string};
export type Block =
  | {type: 'cards'; eyebrow?: string; title: string; text?: string; cols?: 2 | 3 | 4; items: {title: string; text: string; tag?: string}[]; tone?: 'light' | 'dark'}
  | {type: 'steps'; eyebrow?: string; title: string; text?: string; items: {title: string; text: string}[]}
  | {type: 'split'; eyebrow?: string; title: string; text: string; list: string[]; cta?: Cta; aside: {title: string; lines: string[]}}
  | {type: 'faq'; title: string; items: {q: string; a: string}[]}
  | {type: 'cta'; title: string; text: string; cta: Cta; secondary?: Cta};

interface Props {
  lang: Lang;
  title: string;
  description: string;
  noindex?: boolean;
  hero: {pill: string; h1: [string, string]; lead: string; cta?: Cta; secondary?: Cta; dark?: boolean; badge?: string};
  blocks: Block[];
}
const {lang, title, description, noindex, hero, blocks} = Astro.props;
---

<Base lang={lang} title={title} description={description} noindex={noindex}>
  <section class:list={['i-hero', {dark: hero.dark}]}>
    <div class="glow blue" style="width:600px;height:600px;left:-220px;top:-260px" aria-hidden="true"></div>
    <div class="glow indigo" style="width:640px;height:640px;right:-260px;top:-180px" aria-hidden="true"></div>
    <div class="container i-head">
      <span class:list={['pill', {'on-dark': hero.dark}]} data-reveal><span class="dot"></span>{hero.pill}</span>
      <h1 data-reveal>{hero.h1[0]} <span class="grad-text">{hero.h1[1]}</span></h1>
      <p class="lead" data-reveal>{hero.lead}</p>
      {(hero.cta || hero.secondary) && (
        <div class="i-ctas" data-reveal>
          {hero.cta && <a class="btn btn-primary" href={hero.cta.href}>{hero.cta.label} <span class="arrow">→</span></a>}
          {hero.secondary && <a class:list={['btn', hero.dark ? 'btn-glass' : 'btn-ghost']} href={hero.secondary.href}>{hero.secondary.label}</a>}
        </div>
      )}
      {hero.badge && <p class="i-badge" data-reveal>{hero.badge}</p>}
    </div>
  </section>

  {blocks.map((b, bi) => {
    if (b.type === 'cards')
      return (
        <section class:list={['section', 'i-cards', {dark: b.tone === 'dark', alt: bi % 2 === 1 && b.tone !== 'dark'}]}>
          <div class="container">
            <div class="section-head">
              {b.eyebrow && <span class:list={['pill', {'on-dark': b.tone === 'dark'}]}><span class="dot"></span>{b.eyebrow}</span>}
              <h2>{b.title}</h2>
              {b.text && <p class="lead">{b.text}</p>}
            </div>
            <div class="grid" style={`--cols:${b.cols ?? 3}`}>
              {b.items.map((it, i) => (
                <article class="card" data-reveal>
                  <span class="ix" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  {it.tag && <span class="tag">{it.tag}</span>}
                  <h3>{it.title}</h3>
                  <p>{it.text}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
      );
    if (b.type === 'steps')
      return (
        <section class:list={['section', 'i-steps', {alt: bi % 2 === 1}]}>
          <div class="container">
            <div class="section-head">
              {b.eyebrow && <span class="pill"><span class="dot"></span>{b.eyebrow}</span>}
              <h2>{b.title}</h2>
              {b.text && <p class="lead">{b.text}</p>}
            </div>
            <ol>
              {b.items.map((it, i) => (
                <li data-reveal>
                  <span class="n">{i + 1}</span>
                  <h3>{it.title}</h3>
                  <p>{it.text}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>
      );
    if (b.type === 'split')
      return (
        <section class:list={['section', 'i-split', {alt: bi % 2 === 1}]}>
          <div class="container split">
            <div class="split-text" data-reveal>
              {b.eyebrow && <span class="pill"><span class="dot"></span>{b.eyebrow}</span>}
              <h2>{b.title}</h2>
              <p class="lead">{b.text}</p>
              <ul>{b.list.map((l) => <li>{l}</li>)}</ul>
              {b.cta && <a class="btn btn-primary" href={b.cta.href}>{b.cta.label} <span class="arrow">→</span></a>}
            </div>
            <div class="split-aside" data-reveal>
              <p class="aside-title">{b.aside.title}</p>
              {b.aside.lines.map((l, i) => (
                <div class="aside-line" style={`--d:${i * 0.08}s`}>
                  <span class="px" aria-hidden="true"></span>
                  {l}
                </div>
              ))}
            </div>
          </div>
        </section>
      );
    if (b.type === 'faq')
      return (
        <section class="section i-faq">
          <div class="container narrow">
            <h2>{b.title}</h2>
            <div class="faq-list">
              {b.items.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          </div>
        </section>
      );
    return (
      <section class="i-end">
        <div class="container">
          <div class="end-card" data-reveal>
            <h2>{b.title}</h2>
            <p class="lead">{b.text}</p>
            <div class="i-ctas">
              <a class="btn btn-primary" href={b.cta.href}>{b.cta.label} <span class="arrow">→</span></a>
              {b.secondary && <a class="btn btn-glass" href={b.secondary.href}>{b.secondary.label}</a>}
            </div>
          </div>
        </div>
      </section>
    );
  })}
</Base>

<style>
  .i-hero {
    position: relative;
    overflow: hidden;
    padding: 160px 0 clamp(64px, 9vw, 112px);
    background: var(--grad-soft);
  }
  .i-hero.dark {
    background: var(--grad-navy);
    color: #c9d6e8;
  }
  .i-head {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 22px;
    justify-items: center;
    text-align: center;
    max-width: 920px;
  }
  .i-head h1 {
    font-size: clamp(40px, 6vw, 72px);
  }
  .dark .i-head h1 {
    color: #fff;
  }
  .i-head .lead {
    max-width: 720px;
  }
  .dark .i-head .lead {
    color: #b6c6da;
  }
  .i-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .i-badge {
    font-size: 14px;
    color: var(--muted);
  }
  .dark .i-badge {
    color: #9fb3c8;
  }
  .alt {
    background: #fff;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 20px;
  }
  .i-cards .card {
    position: relative;
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 28px;
    transition: transform 0.25s var(--ease), box-shadow 0.25s;
  }
  .i-cards .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .ix {
    font: 650 14px/1 var(--font-display);
    color: var(--indigo);
    letter-spacing: 0.04em;
  }
  .tag {
    position: absolute;
    top: 24px;
    right: 24px;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--bg-2);
    font: 600 12px/1 var(--font-text);
    color: var(--ink-2);
  }
  .i-cards p {
    color: var(--ink-2);
    font-size: 16px;
  }
  .i-cards.dark {
    background: var(--grad-navy);
  }
  .i-cards.dark h2,
  .i-cards.dark h3 {
    color: #fff;
  }
  .i-cards.dark .lead,
  .i-cards.dark p {
    color: #b6c6da;
  }
  .i-cards.dark .card {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: none;
  }
  .i-cards.dark .ix {
    color: #8fb7ff;
  }
  .i-steps ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    counter-reset: s;
  }
  .i-steps li {
    position: relative;
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 28px 24px;
    border-radius: var(--r-lg);
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .i-steps .n {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--grad);
    color: #fff;
    font: 650 18px/1 var(--font-display);
  }
  .i-steps p {
    color: var(--ink-2);
    font-size: 16px;
  }
  .split {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }
  .split-text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .split-text ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }
  .split-text li {
    position: relative;
    padding-left: 30px;
    color: var(--ink-2);
  }
  .split-text li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 5px;
    background: var(--grad);
  }
  .split-aside {
    display: grid;
    gap: 10px;
    padding: 28px;
    border-radius: var(--r-xl);
    background: var(--grad-navy);
    color: #dbe6f3;
    box-shadow: var(--shadow-lg);
  }
  .aside-title {
    font: 600 12px/1 var(--font-text);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8fb7ff;
    margin-bottom: 6px;
  }
  .aside-line {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 15.5px;
  }
  .px {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: linear-gradient(135deg, #5fd0ff, #a79bff);
  }
  .narrow {
    max-width: 820px;
  }
  .i-faq h2 {
    margin-bottom: 28px;
  }
  .faq-list {
    display: grid;
    gap: 10px;
  }
  details {
    border-radius: var(--r);
    background: #fff;
    border: 1px solid var(--line);
    padding: 0 22px;
  }
  summary {
    cursor: pointer;
    padding: 20px 0;
    font: 600 17px/1.35 var(--font-display);
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  summary::after {
    content: '+';
    font-size: 22px;
    line-height: 1;
    color: var(--indigo);
  }
  details[open] summary::after {
    content: '–';
  }
  details p {
    padding-bottom: 20px;
    color: var(--ink-2);
  }
  .i-end {
    padding: 0 0 var(--section);
  }
  .end-card {
    display: grid;
    gap: 18px;
    justify-items: center;
    text-align: center;
    padding: clamp(40px, 6vw, 72px) clamp(24px, 5vw, 64px);
    border-radius: var(--r-xl);
    background: radial-gradient(120% 120% at 100% 0%, #4f46e5 0%, #1a2f6b 40%, var(--navy) 75%);
  }
  .end-card h2 {
    color: #fff;
    max-width: 760px;
  }
  .end-card .lead {
    color: #b6c6da;
    max-width: 640px;
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .split {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
