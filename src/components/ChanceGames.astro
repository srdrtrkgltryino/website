---
// Daily chance games of the visitor program: a scratch card (pick one of three, scratch it) and, once it is scratched,
// one spin of the wheel. Prizes and limits live in src/lib/visitor.ts.
import {type Lang} from '../i18n';
import {vt} from '../i18n/visitor';
import {WHEEL} from '../lib/visitor';
import {company} from '../data/company';
import {href} from '../i18n';

interface Props {
  lang: Lang;
}
const {lang} = Astro.props;
const v = vt(lang);
const c = v.chance;
const li = {linkedin: company.linkedin, product: company.linkedinProduct, share: new URL(href(lang, 'play'), Astro.site ?? 'https://www.tryino.com').href + '/badge/'};

// Wheel drawing: 8 segments, clockwise from the top.
const R = 150;
const seg = 360 / WHEEL.length;
const colors = ['#0B1F3A', '#00A4E4', '#13294B', '#FFB547', '#1A2F6B', '#4F46E5', '#0B1F3A', '#2FBF8F'];
const point = (deg: number, r = R) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [R + r * Math.cos(a), R + r * Math.sin(a)];
};
const slices = WHEEL.map((w, i) => {
  const [x1, y1] = point(i * seg);
  const [x2, y2] = point((i + 1) * seg);
  const [tx, ty] = point(i * seg + seg / 2, R * 0.68);
  const light = colors[i] === '#FFB547' || colors[i] === '#2FBF8F';
  return {d: `M${R},${R} L${x1},${y1} A${R},${R} 0 0 1 ${x2},${y2} Z`, fill: colors[i], tx, ty, rot: i * seg + seg / 2, label: w.prize, ink: light ? '#0B1F3A' : '#fff'};
});
---

<div class="cg" data-chance data-copy={JSON.stringify({...v, lang})} data-li={JSON.stringify(li)}>
  <article class="cg-card" aria-labelledby="cg-scratch-title">
    <header>
      <h3 id="cg-scratch-title">{c.scratchTitle}</h3>
      <span class="cg-status" data-scratch-status></span>
    </header>
    <div class="sc-stage" data-scratch></div>
    <p class="cg-note" data-scratch-note></p>
    <div class="cg-li" data-scratch-li></div>
  </article>

  <article class="cg-card" aria-labelledby="cg-wheel-title">
    <header>
      <h3 id="cg-wheel-title">{c.wheelTitle}</h3>
      <span class="cg-status" data-wheel-status></span>
    </header>
    <div class="wh-stage">
      <div class="wh-pointer" aria-hidden="true"></div>
      <svg class="wh" viewBox={`0 0 ${R * 2} ${R * 2}`} data-wheel aria-hidden="true">
        {slices.map((s) => (
          <g>
            <path d={s.d} fill={s.fill} stroke="rgba(255,255,255,.18)" stroke-width="1.5" />
            <text x={s.tx} y={s.ty} transform={`rotate(${s.rot} ${s.tx} ${s.ty})`} fill={s.ink} text-anchor="middle" dominant-baseline="middle">{s.label}<tspan class="xp" dx="3">XP</tspan></text>
          </g>
        ))}
        <circle cx={R} cy={R} r={R - 1} fill="none" stroke="rgba(255,255,255,.35)" stroke-width="2" />
      </svg>
      <button class="wh-btn" type="button" data-spin>{c.spin}</button>
    </div>
    <p class="cg-note" data-wheel-note role="status"></p>
    <div class="cg-li" data-wheel-li></div>
  </article>

</div>

<script>
  import * as V from '../lib/visitor';
  import {confetti, fmt, linkedinStep, type LinkedInLinks} from '../lib/visitor-ui';
  import type {VisitorCopy} from '../i18n/visitor';

  const root = document.querySelector<HTMLElement>('[data-chance]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const v = JSON.parse(root.dataset.copy!) as VisitorCopy & {lang: string};
    const c = v.chance;
    const li = JSON.parse(root.dataset.li!) as LinkedInLinks;
    const step = (badge?: V.BadgeId) => linkedinStep(V.get(), li, v, badge);
    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SEG = 360 / V.WHEEL.length;
    let scratching = false;
    let spinning = false;

    const untilMidnight = () => {
      const now = new Date();
      const next = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
      const s = Math.max(0, Math.floor((next.getTime() - now.getTime()) / 1000));
      const h = Math.floor(s / 3600);
      const m = Math.floor((s % 3600) / 60);
      return v.lang === 'tr' ? `${h} sa ${m} dk` : `${h}h ${m}m`;
    };
    const big = (el: Element) => {
      const b = el.getBoundingClientRect();
      confetti(b.left + b.width / 2, b.top + b.height / 2);
    };

    // Scratch card
    function renderScratch() {
      const stage = q('[data-scratch]');
      const note = q('[data-scratch-note]');
      const status = q('[data-scratch-status]');
      const sc = V.chance()?.scratch;
      q('[data-scratch-li]').innerHTML = sc?.claimed ? step(sc.prize >= V.RULES.lucky ? 'lucky' : undefined) : '';
      if (!sc) {
        status.textContent = '';
        note.textContent = c.pickCard;
        stage.className = 'sc-stage pick';
        stage.innerHTML = [0, 1, 2]
          .map((i) => `<button type="button" class="sc-back" data-card="${i}" aria-label="${fmt(c.card, {n: i + 1})}"><span></span></button>`)
          .join('');
        return;
      }
      if (!sc.claimed) {
        status.textContent = '';
        note.textContent = c.scratchHint;
        stage.className = 'sc-stage scratching';
        stage.innerHTML = `<div class="sc-ticket"><div class="sc-prize"><strong>+${sc.prize}</strong><small>XP</small></div>
          <canvas data-foil aria-hidden="true"></canvas></div>
          <button type="button" class="sc-reveal" data-reveal-card>${c.reveal}</button>`;
        setupFoil();
        return;
      }
      status.textContent = fmt(c.nextIn, {t: untilMidnight()});
      note.textContent = `${fmt(c.won, {n: sc.prize})}. ${fmt(c.others, {a: sc.others[0], b: sc.others[1]})}`;
      stage.className = 'sc-stage done';
      let o = 0;
      stage.innerHTML = [0, 1, 2]
        .map((i) => {
          const mine = i === sc.card;
          const val = mine ? sc.prize : sc.others[o++];
          return `<div class="sc-face${mine ? ' mine' : ''}"><strong>+${val}</strong><small>XP</small></div>`;
        })
        .join('');
    }

    function setupFoil() {
      const canvas = q<HTMLCanvasElement>('[data-foil]');
      const ticket = canvas.parentElement!;
      const W = ticket.clientWidth;
      const H = ticket.clientHeight;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      const g = canvas.getContext('2d', {willReadFrequently: true})!;
      g.scale(dpr, dpr);
      const grad = g.createLinearGradient(0, 0, W, H);
      grad.addColorStop(0, '#c9d2de');
      grad.addColorStop(0.5, '#eef2f7');
      grad.addColorStop(1, '#b7c2d1');
      g.fillStyle = grad;
      g.fillRect(0, 0, W, H);
      g.fillStyle = 'rgba(11,31,58,.08)';
      for (let x = 10; x < W; x += 22) for (let y = 10; y < H; y += 22) g.fillRect(x, y, 6, 6);
      g.fillStyle = 'rgba(11,31,58,.55)';
      g.font = `650 ${Math.round(W / 9)}px "Outfit Variable", system-ui, sans-serif`;
      g.textAlign = 'center';
      g.textBaseline = 'middle';
      g.fillText(v.lang === 'tr' ? 'KAZI' : 'SCRATCH', W / 2, H / 2);
      g.globalCompositeOperation = 'destination-out';
      scratching = true;

      let down = false;
      let last: [number, number] | null = null;
      let moves = 0;
      const at = (e: PointerEvent): [number, number] => {
        const b = canvas.getBoundingClientRect();
        return [e.clientX - b.left, e.clientY - b.top];
      };
      const scratch = (p: [number, number]) => {
        g.lineWidth = 44;
        g.lineCap = 'round';
        g.beginPath();
        g.moveTo(...(last ?? p));
        g.lineTo(...p);
        g.stroke();
        last = p;
        if (++moves % 8 === 0 && cleared() > 0.5) finish();
      };
      const cleared = () => {
        const d = g.getImageData(0, 0, canvas.width, canvas.height).data;
        let clear = 0;
        let n = 0;
        for (let i = 3; i < d.length; i += 4 * 16) {
          n++;
          if (d[i] === 0) clear++;
        }
        return clear / n;
      };
      const finish = () => {
        if (!scratching) return;
        scratching = false;
        canvas.style.transition = 'opacity .5s';
        canvas.style.opacity = '0';
        const award = V.claimScratch();
        if (award && award.xp >= V.RULES.lucky) big(ticket);
        setTimeout(render, 700);
      };
      canvas.addEventListener('pointerdown', (e) => {
        down = true;
        last = null;
        canvas.setPointerCapture(e.pointerId);
        scratch(at(e));
      });
      canvas.addEventListener('pointermove', (e) => down && scratch(at(e)));
      canvas.addEventListener('pointerup', () => ((down = false), (last = null)));
      q('[data-reveal-card]').addEventListener('click', finish);
    }

    // Wheel
    const wheel = q<SVGElement>('[data-wheel]');
    const spinBtn = q<HTMLButtonElement>('[data-spin]');
    const restAngle = (segment: number) => 360 - (segment * SEG + SEG / 2);

    function renderWheel() {
      const note = q('[data-wheel-note]');
      const status = q('[data-wheel-status]');
      if (spinning) return;
      const ch = V.isStarted() ? V.chance() : undefined;
      q('[data-wheel-li]').innerHTML = ch?.wheel?.claimed ? step(ch.wheel.prize >= V.RULES.lucky ? 'lucky' : undefined) : '';
      const unlocked = !!ch?.scratch?.claimed;
      if (ch?.wheel && !ch.wheel.claimed) V.claimWheel(); // closed mid-spin: credit it now
      if (ch?.wheel) {
        wheel.style.transition = 'none';
        wheel.style.transform = `rotate(${restAngle(ch.wheel.segment)}deg)`;
        spinBtn.disabled = true;
        root.classList.remove('wh-locked');
        status.textContent = fmt(c.nextIn, {t: untilMidnight()});
        note.textContent = `${fmt(c.won, {n: ch.wheel.prize})}. ${c.wheelDone}`;
        return;
      }
      spinBtn.disabled = !unlocked;
      root.classList.toggle('wh-locked', !unlocked);
      status.textContent = '';
      note.textContent = unlocked ? '' : c.wheelLocked;
    }

    spinBtn.addEventListener('click', () => {
      if (spinning) return;
      spinning = true; // before spinWheel(): its change event must not re-render the wheel
      const w = V.spinWheel();
      if (!w || w.claimed) {
        spinning = false;
        return;
      }
      spinBtn.disabled = true;
      spinBtn.textContent = c.spinning;
      const target = 360 * (reduced ? 1 : 6) + restAngle(w.segment);
      wheel.style.transition = 'none';
      wheel.style.transform = 'rotate(0deg)';
      wheel.getBoundingClientRect();
      wheel.style.transition = `transform ${reduced ? 0.6 : 5}s cubic-bezier(.12,.7,.08,1)`;
      wheel.style.transform = `rotate(${target}deg)`;
      const done = () => {
        if (!spinning) return;
        spinning = false;
        spinBtn.textContent = c.spin;
        const award = V.claimWheel();
        if (award && award.xp >= V.RULES.lucky) big(wheel);
        render();
      };
      wheel.addEventListener('transitionend', done, {once: true});
      setTimeout(done, reduced ? 900 : 5400);
    });

    root.addEventListener('click', (e) => {
      const card = (e.target as Element).closest<HTMLElement>('[data-card]');
      if (!card) return;
      // Picking a card is the visitor's own action, so it starts the (browser-only) profile if there isn't one.
      if (!V.isStarted()) V.start(document.querySelector<HTMLElement>('[data-vp]')?.dataset.page);
      V.pickScratch(Number(card.dataset.card));
      render();
    });

    function render() {
      if (!scratching) renderScratch();
      renderWheel();
    }
    document.addEventListener('visitor:change', () => !scratching && !spinning && render());
    document.fonts.ready.then(render);
    render();
  }
</script>

<style>
  .cg {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .cg-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 16px;
    padding: 24px;
    border-radius: var(--r-xl);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(10px);
    min-height: 420px;
  }
  .cg-card header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .cg-card h3 {
    color: #fff;
  }
  .cg-status {
    font-size: 13.5px;
    color: #9fb3c8;
  }
  .cg-li {
    display: flex;
    justify-content: center;
  }
  .cg-li:empty {
    display: none;
  }
  .cg-note {
    min-height: 1.5em;
    font-size: 15px;
    color: #c9d6e8;
    text-align: center;
  }

  /* Scratch card */
  .sc-stage {
    display: grid;
    align-items: center;
    justify-items: center;
  }
  .sc-stage.pick,
  .sc-stage.done {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .sc-stage :global(.sc-back),
  .sc-stage :global(.sc-face) {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 18px;
    border: 0;
  }
  .sc-stage :global(.sc-back) {
    position: relative;
    cursor: pointer;
    background: linear-gradient(150deg, #00a4e4, #4f46e5);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.3), inset 0 0 0 2px rgba(255, 255, 255, 0.25);
    transition: transform 0.25s var(--ease), box-shadow 0.25s;
  }
  .sc-stage :global(.sc-back span) {
    position: absolute;
    inset: 14px;
    border-radius: 10px;
    background-image: radial-gradient(rgba(255, 255, 255, 0.35) 2.5px, transparent 3px);
    background-size: 16px 16px;
    opacity: 0.7;
  }
  .sc-stage :global(.sc-back:hover) {
    transform: translateY(-6px) rotate(-2deg);
    box-shadow: 0 22px 40px rgba(0, 0, 0, 0.35), inset 0 0 0 2px rgba(255, 255, 255, 0.4);
  }
  .sc-stage :global(.sc-face) {
    display: grid;
    place-content: center;
    justify-items: center;
    background: rgba(255, 255, 255, 0.08);
    color: #9fb3c8;
  }
  .sc-stage :global(.sc-face.mine) {
    background: #fff;
    color: var(--navy);
    box-shadow: 0 0 0 3px var(--amber), 0 14px 30px rgba(0, 0, 0, 0.3);
  }
  .sc-stage :global(.sc-face strong),
  .sc-stage :global(.sc-prize strong) {
    font: 650 clamp(26px, 3vw, 34px)/1 var(--font-display);
  }
  .sc-stage :global(.sc-face small),
  .sc-stage :global(.sc-prize small) {
    font-weight: 600;
    font-size: 13px;
  }
  .sc-stage.scratching {
    gap: 12px;
  }
  .sc-stage :global(.sc-ticket) {
    position: relative;
    width: min(100%, 300px);
    aspect-ratio: 5 / 3;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 0 0 3px var(--amber), 0 18px 40px rgba(0, 0, 0, 0.35);
  }
  .sc-stage :global(.sc-prize) {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    color: var(--navy);
  }
  .sc-stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: grab;
  }
  .sc-stage :global(.sc-reveal) {
    padding: 6px 12px;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: #c9d6e8;
    font: 500 13px/1 var(--font-text);
    cursor: pointer;
  }

  /* Wheel */
  .wh-stage {
    position: relative;
    width: min(100%, 300px);
    aspect-ratio: 1;
    justify-self: center;
  }
  .wh {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.08), 0 24px 60px rgba(0, 0, 0, 0.4);
    will-change: transform;
  }
  .wh text {
    font: 700 21px/1 var(--font-display);
  }
  .wh .xp {
    font-size: 11px;
    font-weight: 700;
    opacity: 0.85;
  }
  .wh-pointer {
    position: absolute;
    top: -10px;
    left: 50%;
    z-index: 1;
    width: 30px;
    height: 34px;
    transform: translateX(-50%);
    background: var(--amber);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.4));
  }
  .wh-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 84px;
    height: 84px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 4px solid #fff;
    background: var(--grad);
    color: #fff;
    font: 650 17px/1 var(--font-display);
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
  }
  .wh-btn:disabled {
    cursor: default;
    background: #34476b;
  }
  .wh-locked .wh {
    filter: grayscale(0.7) brightness(0.7);
  }
  @media (max-width: 760px) {
    .cg {
      grid-template-columns: 1fr;
    }
    .cg-card {
      min-height: 0;
    }
  }
</style>
