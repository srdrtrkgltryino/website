---
// Demo booking: pick a preferred day and time (Türkiye time), fill in a short form, and our server e-mails the request
// to the team (functions/api/demo-request.js on Cloudflare, Microsoft Graph). If that fails, the
// visitor gets a ready-made e-mail and a copy button instead, so no request is lost. A POC code is prefilled.
import {href, type Lang} from '../i18n';
import {company as co} from '../data/company';

interface Props {
  lang: Lang;
}
const {lang} = Astro.props;
const c = {
  en: {
    step1: 'Pick a time',
    step2: 'Your details',
    tz: 'Times are in Türkiye time (UTC+3). We confirm by e-mail within one business day.',
    local: 'your time',
    noDay: 'Choose a day to see times.',
    prev: 'Earlier days',
    next: 'Later days',
    name: 'Full name',
    email: 'Work e-mail',
    company: 'Company',
    phone: 'Phone (optional)',
    topic: 'What would you like to see?',
    topics: ['Ino Loyalty demo', 'Ino Loyalty for Shopify or ikas', 'Developer and API questions', 'CRM implementation (Dynamics 365)', 'BrowserPing', 'Something else'],
    message: 'Anything we should know? (optional)',
    messagePh: 'Number of stores, channels, current loyalty program…',
    coupon: 'Free POC code (optional)',
    linkedin: 'Your LinkedIn profile (needed for the free POC)',
    linkedinPh: 'linkedin.com/in/your-name',
    notice: 'We use these details only to reply and arrange the demo.',
    privacy: 'Privacy policy',
    submit: 'Request this time',
    submitNoSlot: 'Request a demo',
    sending: 'Sending…',
    okTitle: 'Request received',
    okText: 'Thanks, {name}. We have your request for {slot} and will confirm by e-mail within one business day.',
    okNoSlot: 'Thanks, {name}. We have your request and will get back to you by e-mail within one business day.',
    copy: 'Copy request',
    copied: 'Copied',
    openAgain: 'Open the e-mail',
    required: 'Please fill in your name, work e-mail and company.',
    invalidEmail: 'That e-mail address doesn\'t look right.',
    doneTitle: 'We couldn’t send it from here',
    doneText: 'Sorry, {name}: our server didn’t answer. Your request is ready as an e-mail; open it and press send, or copy it.',
    doneNoSlot: 'Sorry, {name}: our server didn’t answer. Your request is ready as an e-mail; open it and press send, or copy it.',
    manual: 'No mail app? Copy the request and send it to {mail}.',
    ics: 'Add it to your calendar',
    icsNote: 'Tentative until we confirm by e-mail. A reminder is set 30 minutes before.',
    icsApple: 'Apple / other (.ics)',
    icsTitle: 'Ino Loyalty demo with Tryino (to be confirmed)',
    weekdays: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'],
  },
  tr: {
    step1: 'Zaman seçin',
    step2: 'Bilgileriniz',
    tz: 'Saatler Türkiye saatidir (UTC+3). Bir iş günü içinde e-postayla onaylarız.',
    local: 'sizin saatiniz',
    noDay: 'Saatleri görmek için bir gün seçin.',
    prev: 'Önceki günler',
    next: 'Sonraki günler',
    name: 'Ad soyad',
    email: 'İş e-postası',
    company: 'Şirket',
    phone: 'Telefon (isteğe bağlı)',
    topic: 'Ne görmek istersiniz?',
    topics: ['Ino Loyalty demosu', 'Shopify ya da ikas için Ino Loyalty', 'Geliştirici ve API soruları', 'CRM implementasyonu (Dynamics 365)', 'BrowserPing', 'Başka bir konu'],
    message: 'Bilmemiz gereken bir şey var mı? (isteğe bağlı)',
    messagePh: 'Mağaza sayısı, kanallar, mevcut sadakat programı…',
    coupon: 'Ücretsiz POC kodu (isteğe bağlı)',
    linkedin: 'LinkedIn profiliniz (ücretsiz POC için gerekli)',
    linkedinPh: 'linkedin.com/in/adiniz',
    notice: 'Bu bilgileri yalnızca size dönmek ve demoyu planlamak için kullanırız.',
    privacy: 'Gizlilik politikası',
    submit: 'Bu saati talep et',
    submitNoSlot: 'Demo talep et',
    sending: 'Gönderiliyor…',
    okTitle: 'Talebiniz alındı',
    okText: 'Teşekkürler {name}. {slot} için talebiniz bize ulaştı; bir iş günü içinde e-postayla onaylayacağız.',
    okNoSlot: 'Teşekkürler {name}. Talebiniz bize ulaştı; bir iş günü içinde e-postayla dönüş yapacağız.',
    copy: 'Talebi kopyala',
    copied: 'Kopyalandı',
    openAgain: 'E-postayı aç',
    required: 'Lütfen ad, iş e-postası ve şirket alanlarını doldurun.',
    invalidEmail: 'E-posta adresi doğru görünmüyor.',
    doneTitle: 'Buradan gönderemedik',
    doneText: 'Üzgünüz {name}, sunucumuz yanıt vermedi. Talebiniz e-posta olarak hazır; açıp gönderebilir ya da kopyalayabilirsiniz.',
    doneNoSlot: 'Üzgünüz {name}, sunucumuz yanıt vermedi. Talebiniz e-posta olarak hazır; açıp gönderebilir ya da kopyalayabilirsiniz.',
    manual: 'E-posta uygulamanız yok mu? Talebi kopyalayıp {mail} adresine gönderin.',
    ics: 'Takviminize ekleyin',
    icsNote: 'E-postayla onaylayana kadar kesinleşmemiş sayılır. 30 dakika önce hatırlatma kurulur.',
    icsApple: 'Apple / diğer (.ics)',
    icsTitle: 'Tryino ile Ino Loyalty demosu (onay bekliyor)',
    weekdays: ['Pzt', 'Sal', 'Çar', 'Per', 'Cum'],
  },
}[lang];
const copy = {...c, lang, mailto: co.infoEmail};
---

<div class="booking" data-booking data-copy={JSON.stringify(copy)}>
  <form class="b-form" novalidate data-form>
    <fieldset class="b-step">
      <legend><span class="n">1</span>{c.step1}</legend>
      <div class="b-cal">
        <div class="b-cal-head">
          <button type="button" class="b-nav" data-prev aria-label={c.prev}>‹</button>
          <strong data-range></strong>
          <button type="button" class="b-nav" data-next aria-label={c.next}>›</button>
        </div>
        <div class="b-days" role="radiogroup" aria-label={c.step1} data-days></div>
        <div class="b-slots" role="radiogroup" data-slots><p class="b-muted">{c.noDay}</p></div>
        <p class="b-tz">{c.tz}</p>
      </div>
    </fieldset>

    <fieldset class="b-step">
      <legend><span class="n">2</span>{c.step2}</legend>
      <div class="b-grid">
        <label><span>{c.name}</span><input name="name" autocomplete="name" required /></label>
        <label><span>{c.email}</span><input name="email" type="email" autocomplete="email" required /></label>
        <label><span>{c.company}</span><input name="company" autocomplete="organization" required /></label>
        <label><span>{c.phone}</span><input name="phone" type="tel" autocomplete="tel" /></label>
        <label class="wide"><span>{c.topic}</span>
          <select name="topic">{c.topics.map((t) => <option>{t}</option>)}</select>
        </label>
        <label class="wide"><span>{c.message}</span><textarea name="message" rows="3" placeholder={c.messagePh}></textarea></label>
        <label data-coupon-row hidden><span>{c.coupon}</span><input name="coupon" readonly tabindex="-1" autocomplete="off" spellcheck="false" data-coupon /></label>
        <label data-coupon-row hidden><span>{c.linkedin}</span><input name="linkedin" type="url" inputmode="url" autocomplete="url" spellcheck="false" placeholder={c.linkedinPh} /></label>
      </div>
        <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
      <p class="b-notice">{c.notice} <a href={href(lang, 'privacy')}>{c.privacy}</a></p>
      <p class="b-error" role="alert" data-error hidden></p>
      <button class="btn btn-primary b-submit" type="submit" data-submit>{c.submitNoSlot} <span class="arrow">→</span></button>
    </fieldset>
  </form>

  <div class="b-result" data-ok hidden tabindex="-1">
    <span class="b-check" aria-hidden="true">✓</span>
    <h3>{c.okTitle}</h3>
    <p data-ok-text></p>
    <div class="b-cal-add" data-cal hidden></div>
  </div>
  <div class="b-result" data-done hidden tabindex="-1">
    <span class="b-check fail" aria-hidden="true">✉</span>
    <h3>{c.doneTitle}</h3>
    <p data-done-text></p>
    <div class="b-actions">
      <a class="btn btn-primary" data-mailto href="#">{c.openAgain} <span class="arrow">→</span></a>
      <button type="button" class="btn btn-ghost" data-copy>{c.copy}</button>
    </div>
    <p class="b-manual">{c.manual.replace('{mail}', co.infoEmail)}</p>
    <div class="b-cal-add" data-cal hidden></div>
  </div>
</div>

<script>
  import * as V from '../lib/visitor';
  import {analytics} from '../lib/visitor-ui';

  const SLOTS = ['10:00', '11:00', '13:00', '14:00', '15:00', '16:00'];
  const DAYS_SHOWN = 10;
  const TR_OFFSET = 3; // Türkiye is UTC+3 all year

  const root = document.querySelector<HTMLElement>('[data-booking]');
  if (root) {
    const c = JSON.parse(root.dataset.copy!);
    const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const locale = c.lang === 'tr' ? 'tr-TR' : 'en-GB';
    const fmtDay = new Intl.DateTimeFormat(locale, {day: 'numeric', month: 'short'});
    const fmtLong = new Intl.DateTimeFormat(locale, {weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/Istanbul'});
    const fmtLocal = new Intl.DateTimeFormat(locale, {hour: '2-digit', minute: '2-digit'});
    const localIsTR = new Date().getTimezoneOffset() === -TR_OFFSET * 60;

    // Business days from tomorrow (Türkiye date).
    const trToday = new Date(Date.now() + TR_OFFSET * 3600e3);
    const days: Date[] = [];
    for (let d = 1; days.length < DAYS_SHOWN * 2; d++) {
      const day = new Date(Date.UTC(trToday.getUTCFullYear(), trToday.getUTCMonth(), trToday.getUTCDate() + d));
      if (day.getUTCDay() !== 0 && day.getUTCDay() !== 6) days.push(day);
    }
    let page = 0;
    let day: Date | null = null;
    let slot: string | null = null;

    const slotDate = (d: Date, hm: string) => {
      const [h, m] = hm.split(':').map(Number);
      return new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), h - TR_OFFSET, m));
    };
    const slotLabel = () => (day && slot ? `${fmtLong.format(slotDate(day, slot))}, ${slot}` : '');

    function renderDays() {
      const list = days.slice(page * DAYS_SHOWN, (page + 1) * DAYS_SHOWN);
      q('[data-range]').textContent = `${fmtDay.format(list[0])} – ${fmtDay.format(list[list.length - 1])}`;
      q<HTMLButtonElement>('[data-prev]').disabled = page === 0;
      q<HTMLButtonElement>('[data-next]').disabled = page === 1;
      q('[data-days]').innerHTML = list
        .map((d) => {
          const on = day?.getTime() === d.getTime();
          const wd = c.weekdays[(d.getUTCDay() + 6) % 7];
          return `<button type="button" role="radio" aria-checked="${on}" data-day="${d.getTime()}"><small>${wd}</small><strong>${d.getUTCDate()}</strong></button>`;
        })
        .join('');
    }
    function renderSlots() {
      if (!day) return;
      q('[data-slots]').innerHTML = SLOTS.map((s) => {
        const local = localIsTR ? '' : `<small>${fmtLocal.format(slotDate(day!, s))} ${c.local}</small>`;
        return `<button type="button" role="radio" aria-checked="${slot === s}" data-slot="${s}"><strong>${s}</strong>${local}</button>`;
      }).join('');
      const btn = q('[data-submit]');
      btn.firstChild!.textContent = slot ? `${c.submit} ` : `${c.submitNoSlot} `;
    }
    root.addEventListener('click', (e) => {
      const t = e.target as Element;
      const d = t.closest<HTMLElement>('[data-day]');
      if (d) {
        day = new Date(Number(d.dataset.day));
        slot = null;
        renderDays();
        renderSlots();
      }
      const s = t.closest<HTMLElement>('[data-slot]');
      if (s) {
        slot = s.dataset.slot!;
        renderSlots();
      }
    });
    q('[data-prev]').addEventListener('click', () => ((page = 0), renderDays()));
    q('[data-next]').addEventListener('click', () => ((page = 1), renderDays()));
    renderDays();

    // Coupon: from the link (?coupon=) or the visitor profile.
    const fromUrl = new URLSearchParams(location.search).get('coupon');
    const coupon = (fromUrl && /^INO(POC|3M)-[A-Z0-9]{4}-[A-Z0-9]{4}$/.test(fromUrl) ? fromUrl : '') || V.get()?.coupon?.code || '';
    q<HTMLInputElement>('[data-coupon]').value = coupon;
    // POC code and LinkedIn fields only for visitors who unlocked a code; the code is filled in and read-only, so it
    // can't be typed by hand.
    root.querySelectorAll<HTMLElement>('[data-coupon-row]').forEach((el) => (el.hidden = !coupon));

    const form = q<HTMLFormElement>('[data-form]');
    const error = q('[data-error]');
    const field = (n: string) => (form.elements.namedItem(n) as HTMLInputElement).value.trim();

    const L =
      c.lang === 'tr'
        ? {name: 'Ad soyad', company: 'Şirket', email: 'E-posta', phone: 'Telefon', topic: 'Konu', time: 'Tercih edilen zaman', coupon: 'Ücretsiz POC kodu', linkedin: 'LinkedIn'}
        : {name: 'Name', company: 'Company', email: 'E-mail', phone: 'Phone', topic: 'Topic', time: 'Preferred time', coupon: 'Free POC code', linkedin: 'LinkedIn'};
    function mailBody(data: Record<string, string>) {
      return [
        `${L.name}: ${data.name}`,
        `${L.company}: ${data.company}`,
        `${L.email}: ${data.email}`,
        data.phone && `${L.phone}: ${data.phone}`,
        `${L.topic}: ${data.topic}`,
        data.slotLabel && `${L.time}: ${data.slotLabel} (Türkiye)`,
        data.coupon && `${L.coupon}: ${data.coupon}`,
        data.linkedin && `${L.linkedin}: ${data.linkedin}`,
        data.message && `\n${data.message}`,
      ]
        .filter(Boolean)
        .join('\n');
    }

    function ics(data: Record<string, string>) {
      if (!day || !slot) return;
      const start = slotDate(day, slot);
      const end = new Date(start.getTime() + 30 * 60e3);
      const z = (d: Date) => d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
      const text = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//Tryino//Demo//EN',
        'BEGIN:VEVENT',
        `UID:${z(start)}-${Math.random().toString(36).slice(2)}@tryino.com`,
        `DTSTAMP:${z(new Date())}`,
        `DTSTART:${z(start)}`,
        `DTEND:${z(end)}`,
        `SUMMARY:${c.icsTitle}`,
        `DESCRIPTION:${data.topic} · https://www.tryino.com`,
        'STATUS:TENTATIVE',
        'BEGIN:VALARM',
        'ACTION:DISPLAY',
        `DESCRIPTION:${c.icsTitle}`,
        'TRIGGER:-PT30M',
        'END:VALARM',
        'END:VEVENT',
        'END:VCALENDAR',
      ].join('\r\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([text], {type: 'text/calendar'}));
      a.download = 'tryino-demo.ics';
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    }

    // Calendar choices for the chosen slot: Google and Outlook links, and an .ics file for Apple and the rest.
    function renderCal(box: HTMLElement, data: Record<string, string>) {
      box.hidden = !(day && slot);
      if (box.hidden) return;
      const start = slotDate(day!, slot!);
      const end = new Date(start.getTime() + 30 * 60e3);
      const z = (d: Date) => d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
      const details = `${data.topic} · https://www.tryino.com`;
      const google = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(c.icsTitle)}&dates=${z(start)}/${z(end)}&details=${encodeURIComponent(details)}`;
      const outlook = `https://outlook.office.com/calendar/0/deeplink/compose?subject=${encodeURIComponent(c.icsTitle)}&startdt=${encodeURIComponent(start.toISOString())}&enddt=${encodeURIComponent(end.toISOString())}&body=${encodeURIComponent(details)}`;
      box.innerHTML = `<p class="b-cal-title">${c.ics}</p>
        <div class="b-cal-btns">
          <a class="btn btn-primary btn-sm" href="${google}" target="_blank" rel="noopener">Google</a>
          <a class="btn btn-primary btn-sm" href="${outlook}" target="_blank" rel="noopener">Outlook</a>
          <button type="button" class="btn btn-ghost btn-sm" data-ics-file>${c.icsApple}</button>
        </div>
        <p class="b-cal-note">${c.icsNote}</p>`;
      box.querySelector<HTMLButtonElement>('[data-ics-file]')!.onclick = () => ics(data);
    }

    const API = '/api/demo-request';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.hidden = true;
      const data: Record<string, string> = {
        lang: c.lang,
        name: field('name'),
        email: field('email'),
        company: field('company'),
        phone: field('phone'),
        topic: field('topic'),
        message: field('message'),
        coupon: field('coupon').toUpperCase(),
        linkedin: field('linkedin'),
        slot: day && slot ? slotDate(day, slot).toISOString() : '',
        slotLabel: slotLabel(),
        website: field('website'),
      };
      if (!data.name || !data.email || !data.company) {
        error.textContent = c.required;
        error.hidden = false;
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) {
        error.textContent = c.invalidEmail;
        error.hidden = false;
        return;
      }
      const first = data.name.split(' ')[0];
      const btn = q<HTMLButtonElement>('[data-submit]');
      btn.disabled = true;
      btn.firstChild!.textContent = `${c.sending} `;
      let sent = false;
      try {
        const res = await fetch(API, {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(data)});
        sent = res.ok;
      } catch {
        sent = false;
      }
      btn.disabled = false;
      btn.firstChild!.textContent = `${data.slot ? c.submit : c.submitNoSlot} `;
      document.dispatchEvent(new CustomEvent('visitor:track', {detail: 'demo'}));
      if (sent) {
        form.hidden = true;
        const ok = q('[data-ok]');
        q('[data-ok-text]').textContent = (data.slotLabel ? c.okText : c.okNoSlot).replace('{name}', first).replace('{slot}', data.slotLabel);
        renderCal(ok.querySelector<HTMLElement>('[data-cal]')!, data);
        ok.hidden = false;
        ok.focus();
        analytics('generate_lead', {method: 'demo_form', topic: data.topic, has_slot: data.slot ? 1 : 0, has_coupon: data.coupon ? 1 : 0});
        return;
      }
      // Server unreachable: hand the visitor a ready-made e-mail instead (they choose to open it).
      const subject = `${c.lang === 'tr' ? 'Demo talebi' : 'Demo request'}: ${data.company}`;
      const body = mailBody(data);
      const mailto = `mailto:${c.mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      form.hidden = true;
      const done = q('[data-done]');
      q('[data-done-text]').textContent = (data.slotLabel ? c.doneText : c.doneNoSlot).replace('{name}', first).replace('{slot}', data.slotLabel);
      q<HTMLAnchorElement>('[data-mailto]').href = mailto;
      const copyBtn = q<HTMLButtonElement>('[data-copy]');
      copyBtn.onclick = async () => {
        try {
          await navigator.clipboard.writeText(`${c.mailto}\n${subject}\n\n${body}`);
          copyBtn.textContent = c.copied;
          setTimeout(() => (copyBtn.textContent = c.copy), 1800);
        } catch {}
      };
      renderCal(done.querySelector<HTMLElement>('[data-cal]')!, data);
      done.hidden = false;
      done.focus();
      analytics('demo_form_fallback', {topic: data.topic});
    });
  }
</script>

<style>
  .booking {
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--r-xl);
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .b-form {
    display: grid;
    gap: 28px;
  }
  .b-step {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
    display: grid;
    gap: 16px;
  }
  .b-step legend {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0;
    margin-bottom: 14px;
    font: 650 20px/1.2 var(--font-display);
    color: var(--ink);
  }
  .b-step .n {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--grad);
    color: #fff;
    font-size: 15px;
  }
  .b-cal {
    display: grid;
    gap: 14px;
  }
  .b-cal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .b-cal-head strong {
    font: 600 15.5px/1 var(--font-text);
  }
  .b-nav {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid var(--line-2);
    background: #fff;
    font-size: 20px;
    line-height: 1;
    color: var(--ink);
    cursor: pointer;
  }
  .b-nav:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .b-days {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
  }
  .b-days :global(button),
  .b-slots :global(button) {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 10px 6px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, transform 0.15s var(--ease);
  }
  .b-days :global(button:hover),
  .b-slots :global(button:hover) {
    border-color: var(--blue);
  }
  .b-days :global(small) {
    font-size: 12.5px;
    color: var(--muted);
  }
  .b-days :global(strong) {
    font: 650 20px/1 var(--font-display);
  }
  .b-days :global([aria-checked='true']),
  .b-slots :global([aria-checked='true']) {
    background: var(--grad);
    border-color: transparent;
    color: #fff;
  }
  .b-days :global([aria-checked='true'] small),
  .b-slots :global([aria-checked='true'] small) {
    color: rgba(255, 255, 255, 0.8);
  }
  .b-slots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    min-height: 52px;
  }
  .b-slots :global(strong) {
    font: 600 16px/1 var(--font-text);
  }
  .b-slots :global(small) {
    font-size: 11.5px;
    color: var(--muted);
  }
  .b-muted {
